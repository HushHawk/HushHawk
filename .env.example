# ---------------------------------------------------------------------------
# HushHawk configuration. Copy to .env (never commit it) or set these as environment variables.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------
DATABASE_URL=postgresql://username:password@host:5432/hushhawk
# Path to the CA bundle (for AWS RDS: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem).
# When set, the database certificate is verified. When empty the connection is encrypted but not verified.
DATABASE_SSL_CA=

# Public https URL of this API (used to build webhook URLs) and the shared secret every webhook must present.
PUBLIC_API_URL=https://api.example.com
WEBHOOK_SECRET=generate-a-long-random-value

# TEMPORARY: accept webhooks that do not carry the secret yet (set to true only while migrating senders).
WEBHOOK_ALLOW_UNSIGNED=

# Comma-separated browser origins allowed to call the API cross-origin (leave empty when the app and API share a domain).
CORS_ORIGINS=

# --- Podio (two-way CRM sync) --------------------------------------------
PODIO_CLIENT_ID=
PODIO_CLIENT_SECRET=
PODIO_APP_TOKEN=
PODIO_APP_ID=
PODIO_PROPERTIES_APP_ID=
PODIO_FEEDS_APP_ID=
PODIO_OUTBOUND_PHONE=
PODIO_OUTBOUND_EMAIL=
# Minutes between automatic syncs (leave empty to disable the scheduler; `npm run sync:podio` runs one on demand).
PODIO_SYNC_INTERVAL_MIN=10

# --- Private file storage (Amazon S3) ------------------------------------
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Outbound messaging (nothing is reported as sent unless one of these accepts the message) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Outreach compliance gate ---------------------------------------------
OUTREACH_TIMEZONE=America/New_York
OUTREACH_START_HOUR=8
OUTREACH_END_HOUR=20
OUTREACH_MAX_PER_DAY=3
OUTREACH_MAX_PER_WEEK=10

# --- Optional: Neo4j relationship graph (HTTP transactional endpoint) ----
NEO4J_HTTP_URL=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Optional: AI assistant ----------------------------------------------
GEMINI_API_KEY=
