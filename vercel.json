{
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://3.148.218.118/api/:path*"
    },
    {
      "source": "/ww/:path*",
      "destination": "http://3.148.218.118/ww/:path*"
    },
    {
      "source": "/home",
      "destination": "/home/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!api/|ww/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), payment=()"
        }
      ]
    }
  ]
}
